# Builds the verified complete source archive without using older repository folders.
FROM python:3.12-slim AS source
WORKDIR /source
COPY Church_ERP_Sanctuary_OS_Phase7B_Hosting_Readiness_v2_2026-11-13.zip /tmp/source.zip
RUN python -c "import hashlib,zipfile; p='/tmp/source.zip'; assert hashlib.sha256(open(p,'rb').read()).hexdigest() == 'b3a23995829ae3736b8ffdcc494d6318e5e478f6fb25ef001c89c558afda5dce'; zipfile.ZipFile(p).extractall('/source')"

FROM node:22-slim AS frontend
WORKDIR /build
COPY --from=source /source/church_build/frontend/package.json /source/church_build/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY --from=source /source/church_build/frontend/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY --from=source /source/church_build/backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY --from=source /source/church_build/backend/ ./
COPY --from=source /source/church_build/deploy/render_start.py ./render_start.py
COPY --from=frontend /build/dist /app/frontend_dist
EXPOSE 10000
CMD ["python", "render_start.py"]
